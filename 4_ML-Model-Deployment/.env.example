# Laboratorio 4 - Despliegue de modelo AWS - Machine Learning
# Copiar este archivo a .env y completar valores. No incluir credenciales reales.

# Modo de ejecucion.
# Valores posibles: standalone, integrated
LAB_MODE=standalone

# Configuracion AWS.
AWS_PROFILE=PowerUserAccess-654654589924
AWS_REGION=us-east-1

# Convenciones del proyecto.
PROJECT_NAME=ml-model-deployment
ENVIRONMENT=lab
RESOURCE_PREFIX=ml-deploy-lab
S3_PREFIX=ml-deploy-lab/lab
STACK_NAME=ml-deploy-lab

# S3 e IAM.
# Si S3_BUCKET_NAME queda vacio, CloudFormation crea un bucket del laboratorio
# y scripts/deploy_infra.* escribe el valor final en .env.cloud.
CREATE_BUCKET=
S3_BUCKET_NAME=
# Se llena automaticamente en .env.cloud al ejecutar deploy-infra.
SAGEMAKER_EXECUTION_ROLE_ARN=
KMS_KEY_ID=

# Recursos generados por el laboratorio 3 para integrated mode.
MODEL_PACKAGE_GROUP_NAME=
MODEL_PACKAGE_ARN=
MODEL_ARTIFACT_S3_URI=

# Feature Store y contrato de features para integrated mode.
FEATURE_GROUP_NAME=
OFFLINE_STORE_S3_URI=
FEATURE_CONTRACT_S3_URI=

# Recursos standalone.
CREATE_STANDALONE_MODEL=true
# En standalone_mode el lab crea un Feature Group con Online Store y Offline Store.
CREATE_STANDALONE_FEATURE_GROUP=true

# Endpoint y capacidad.
MODEL_NAME=ml-deploy-model
ENDPOINT_NAME=ml-deploy-realtime-endpoint
ENDPOINT_CONFIG_NAME=ml-deploy-realtime-config
INSTANCE_TYPE=ml.m5.large
INITIAL_INSTANCE_COUNT=1
BATCH_INSTANCE_TYPE=ml.m5.large
BATCH_INSTANCE_COUNT=1
BATCH_JOB_PREFIX=ml-deploy-batch
BATCH_SPLIT_TYPE=Line
BATCH_STRATEGY=SingleRecord
MAX_PAYLOAD_IN_MB=6
MAX_CONCURRENT_TRANSFORMS=1
WAIT_FOR_BATCH=true
WAIT_FOR_ENDPOINT=true
INFERENCE_IMAGE_URI=
REALTIME_RECORD_ID=

# Observabilidad y escalamiento.
ENABLE_DATA_CAPTURE=true
ENABLE_AUTOSCALING=true
AUTOSCALING_MIN_CAPACITY=1
AUTOSCALING_MAX_CAPACITY=2
AUTOSCALING_TARGET_INVOCATIONS_PER_INSTANCE=50

# Cleanup.
# Por defecto destroy-all conserva objetos S3. Usar DELETE_LAB_S3=true o --delete-s3
# solo cuando quieras borrar prefijos creados por este laboratorio.
DELETE_LAB_S3=false

# Simulacion local de fraude.
# Por defecto, current transaction features se usan en memoria y no se guardan
# en Online Store para leerlas inmediatamente. Activa esto solo para guardar
# features tipo last_seen que serviran a predicciones futuras.
FRAUD_WRITE_LAST_SEEN_FEATURES=false

# Modo cloud del laboratorio de fraude.
# FRAUD_S3_PREFIX se llena automaticamente desde CloudFormation si ejecutas
# deploy-infra. Representa el Data Lake, exports offline y logs en S3.
FRAUD_S3_PREFIX=ml-deploy-lab/lab/fraud

# Recursos operacionales creados por CloudFormation y escritos en .env.cloud.
FRAUD_DECISION_TABLE_NAME=
FRAUD_EVENT_QUEUE_URL=
FRAUD_EVENT_QUEUE_NAME=

# Prefijo logico para los Feature Groups fisicos de SageMaker Feature Store.
# Los nombres finales reemplazan underscores por guiones, por ejemplo:
# ml-deploy-lab-fraud-user-profile-features
FRAUD_FEATURE_GROUP_PREFIX=ml-deploy-lab-fraud

# Modelo simple de fraude en SageMaker Model Registry.
FRAUD_MODEL_PACKAGE_GROUP_NAME=ml-deploy-lab-fraud-models
FRAUD_MODEL_PACKAGE_ARN=
FRAUD_MODEL_ARTIFACT_S3_URI=
FRAUD_MODEL_NAME=ml-deploy-lab-fraud-model
FRAUD_ENDPOINT_CONFIG_NAME=ml-deploy-lab-fraud-realtime-config

# El flujo fraud-step 05 crea por defecto un SageMaker Real-Time Endpoint real.
# Esto genera costo mientras este activo. Ejecuta fraud-cleanup al terminar.
FRAUD_USE_SAGEMAKER_ENDPOINT=true
FRAUD_ENDPOINT_NAME=ml-deploy-lab-fraud-realtime-endpoint
FRAUD_INSTANCE_TYPE=ml.m5.large
FRAUD_INITIAL_INSTANCE_COUNT=1
FRAUD_ENABLE_DATA_CAPTURE=true
# Lista de candidatos validos para SageMaker Batch Transform. El script prueba el siguiente si la cuota del primero es 0.
FRAUD_BATCH_INSTANCE_TYPE=ml.c6i.large,ml.m6i.large,ml.m5.xlarge,ml.m5.large
FRAUD_BATCH_INSTANCE_COUNT=1
# false permite que el lab continue si la cuenta tiene cuota 0 para Batch Transform.
# true hace que fraud-step 07 falle si no puede crear el job real.
FRAUD_REQUIRE_BATCH_TRANSFORM=false
